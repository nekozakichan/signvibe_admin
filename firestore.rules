rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // A user may read their own document; staff may read anyone's, because the
      // web admin lists students and teachers. A student can no longer read
      // another account's document — that used to expose every user's record,
      // including staff, to anyone holding a student login.
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin']);
      // Admins can update any user doc (unchanged).
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // A student may update ONLY their own photo_url — nothing else.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo_url' , 'photo_updated_at']);
    }
    match /modules/{moduleId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    match /lessons/{lessonId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    match /password_reset_requests/{reqId} {
      // Requests are created by the backend (POST /api/reset-requests), which
      // verifies the email belongs to a teacher first. Letting the browser write
      // here directly meant anyone on the internet could fill the admin's queue.
      allow create: if false;
      allow read, update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /student_progress/{docId} {
      allow read: if request.auth != null
      && (resource.data.student_id == request.auth.uid
      || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin']);
  			allow create, update: if request.auth != null
        && request.resource.data.student_id == request.auth.uid;
 		}
    match /game_sessions/{docId} {
      allow read: if request.auth != null;
      // A student may create only their own sessions. student_id must equal
      // the caller's uid — same shape as student_progress / quiz_results.
      allow create: if request.auth != null
        && request.resource.data.student_id == request.auth.uid;
      // Append-only event log: no update, no delete. Scores can't be rewritten.
      // (Enforced by omission too — this line just makes the intent explicit.)
      allow update, delete: if false;
    }

    // Leaderboards — one keep-best doc per user per game.
   match /leaderboard/{docId} {
     allow read: if request.auth != null;

     allow create, update: if request.auth != null
        && request.resource.data.student_id == request.auth.uid
        && docId == 'flappy_sign_' + request.auth.uid
        && request.resource.data.game_type == 'flappy_sign';

     allow delete: if false;
    }

    match /quiz_results/{docId} {
      allow read: if request.auth != null
        && (resource == null
            || resource.data.student_id == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin']);
      allow create, update: if request.auth != null
        && request.resource.data.student_id == request.auth.uid;
    }

    match /quiz_questions/{questionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // App-wide settings — currently settings/quiz_limits, the single source of
    // truth for how many quiz items each grade sits. Students must be able to
    // READ it (the app sizes their quiz from it); only staff may change it.
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin'];
      allow delete: if false;
    }
  }
}
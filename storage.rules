rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Sign videos: 50 MB max, video files only. Matches MAX_VIDEO_SIZE_MB in
    // ManageModules.jsx — change both together.
    function isVideoUpload() {
      return request.resource.size < 50 * 1024 * 1024
          && request.resource.contentType.matches('video/.*');
    }

    // Lesson demo videos uploaded from Manage Modules
    match /lessons/{moduleName}/{fileName} {
      allow read: if true; // videos are shown to students in the mobile app
      allow create, update: if request.auth != null && isVideoUpload(); // signed-in teachers/admins
      allow delete: if request.auth != null;
    }

    // Quiz question videos uploaded from Manage Quiz (Manage Modules)
    match /quiz-videos/{moduleId}/{fileName} {
      allow read: if true; // videos are shown to students in the mobile app
      allow create, update: if request.auth != null && isVideoUpload();
      allow delete: if request.auth != null;
    }

    // Module icon images uploaded from the Add/Edit Module form
    match /module-icons/{fileName} {
      allow read: if true; // icons are shown to students in the mobile app
      allow write: if request.auth != null; // only signed-in teachers/admins can upload
      allow delete: if request.auth != null;
    }

    // Profile photos from the Android app (ProfileFragment), saved as
    // profile-photos/<uid>.jpg. Each user can only write their own photo.
    match /profile-photos/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && fileName == request.auth.uid + '.jpg'
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
